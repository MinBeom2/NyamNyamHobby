# /home/ubuntu/app/.env 의 형식 (커밋 금지). DB·Redis·RabbitMQ 비밀번호는 /home/ubuntu/infra/.env 와 같은 값
# 컨테이너끼리는 backend 네트워크 안에서 컨테이너 이름과 "내부" 포트(5432, 6379, 5672)로 접속한다
SPRING_PROFILES_ACTIVE=dev

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/nyamnyam
SPRING_DATASOURCE_USERNAME=nyam
SPRING_DATASOURCE_PASSWORD=

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=nyam
RABBITMQ_PASSWORD=

# 애플리케이션 비밀값 (BE/.env.example 과 같은 이름, 기능 개발 시 채움)
JWT_SECRET=
FRONTEND_URL=
# 업로드 이미지 URL 앞부분(생략·빈 값이면 서버 Compose 기본 도메인 사용, 저장 위치는 /app/uploads)
UPLOAD_PUBLIC_BASE_URL=https://k15d104.p.ssafy.io
# 탐색 세션 최대 노출 수 (기본 12, 허용 범위 1~32767). 변경 후 재시작하면 새 세션부터 적용
EXPLORATION_SESSION_SIZE=12
EXPLORATION_PREFER_RATIO=0.7
# 추천 이유 발행 요청 처리
RECOMMENDATION_REASON_OUTBOX_ENABLED=true
GMS_BASE_URL=
GMS_API_KEY=
MAIL_USERNAME=
MAIL_APP_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_API_KEY=
# 숏폼 수집 스케줄러(매시 7분 수집 · 목 06:00 주간 반영). 서버에서만 true
SHORT_COLLECT_ENABLED=true
KAKAO_REST_API_KEY=
TOUR_API_KEY=
KOPIS_API_KEY=
CULTURE_PORTAL_API_KEY=
PUBLIC_DATA_API_KEY=
SEOUL_OPEN_API_KEY=
MATTERMOST_WEBHOOK_URL=
