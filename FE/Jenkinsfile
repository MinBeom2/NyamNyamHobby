// 프론트엔드 CI/CD: dev 브랜치에 FE/ 변경이 들어오면 빌드 → 정적 파일을 새 릴리스 폴더에 복사 → current 링크 교체 → Mattermost 알림
// Jenkins 작업 설정: Pipeline script from SCM · 브랜치 */dev · Script Path = FE/Jenkinsfile
// 서버 준비물: /var/www/nyamnyam (Jenkins 컨테이너에 같은 경로로 마운트), Nginx root = /var/www/nyamnyam/current (infra/server/nginx/site.conf)

pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timeout(time: 20, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    environment {
        BUILD_IMAGE = 'nyam-frontend-build'
        WEB_ROOT    = '/var/www/nyamnyam'
        KEEP        = '5'   // 롤백용으로 남겨 둘 릴리스 수
    }

    stages {
        stage('Frontend') {
            // 백엔드만 바뀐 푸시는 건너뜀. Jenkins에서 직접 [지금 빌드]를 누르면 항상 실행
            when {
                anyOf {
                    changeset 'FE/**'
                    triggeredBy 'UserIdCause'
                }
            }
            stages {
                stage('Build') {
                    steps {
                        // 배포 단계에 들어왔다는 표시. 알림은 이 값이 있을 때만 보낸다
                        script { env.FE_DEPLOY = 'true' }
                        // npm ci → tsc -b(타입 검사) → vite build. 타입 오류가 있으면 여기서 실패하고 서버는 그대로
                        withCredentials([string(credentialsId: 'kakao-map-js-key', variable: 'VITE_KAKAO_MAP_KEY')]) {
                            sh 'docker build --build-arg VITE_KAKAO_MAP_KEY="$VITE_KAKAO_MAP_KEY" -t $BUILD_IMAGE:$BUILD_NUMBER FE'
                        }
                    }
                }
                stage('Extract') {
                    steps {
                        // Jenkins는 서버 Docker를 쓰므로 볼륨 마운트 대신 docker cp로 결과물을 꺼낸다
                        sh '''
                            rm -rf dist
                            CID=$(docker create $BUILD_IMAGE:$BUILD_NUMBER)
                            docker cp "$CID":/app/dist ./dist
                            docker rm "$CID" > /dev/null
                            test -f dist/index.html
                        '''
                    }
                }
                stage('Deploy') {
                    steps {
                        // 새 폴더에 복사한 뒤 current 링크만 바꿔서 배포 중에도 사용자가 깨진 화면을 보지 않게 한다
                        sh '''
                            RELEASE=$WEB_ROOT/releases/$BUILD_NUMBER
                            rm -rf "$RELEASE"
                            mkdir -p "$RELEASE"
                            cp -r dist/. "$RELEASE"/
                            ln -sfn releases/$BUILD_NUMBER $WEB_ROOT/current.tmp
                            mv -Tf $WEB_ROOT/current.tmp $WEB_ROOT/current
                            # 오래된 릴리스 정리 (최신 KEEP개만 유지)
                            ls -1dt $WEB_ROOT/releases/*/ | tail -n +$((KEEP + 1)) | xargs -r rm -rf
                            echo "current -> $(readlink $WEB_ROOT/current)"
                        '''
                    }
                }
                stage('Check') {
                    steps {
                        sh 'grep -q "id=\\"root\\"" $WEB_ROOT/current/index.html'
                    }
                }
            }
        }
    }

    post {
        success {
            script {
                if (env.FE_DEPLOY == 'true') {
                    mattermostSend color: 'good',
                        message: "✅ 프론트엔드 배포 성공 · ${env.JOB_NAME} #${env.BUILD_NUMBER} · https://k15d104.p.ssafy.io"
                }
            }
        }
        failure {
            script {
                if (env.FE_DEPLOY == 'true') {
                    mattermostSend color: 'danger',
                        message: "❌ 프론트엔드 배포 실패 · ${env.JOB_NAME} #${env.BUILD_NUMBER} · 서버는 이전 버전 그대로 · 로그: ${env.BUILD_URL}console"
                }
            }
        }
        always {
            sh 'docker image rm $BUILD_IMAGE:$BUILD_NUMBER > /dev/null 2>&1 || true; docker image prune -f || true'
        }
    }
}
