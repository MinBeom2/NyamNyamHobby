// 백엔드 CI/CD: dev 브랜치에 BE/ 변경이 들어오면 테스트 → 이미지 빌드 → EC2에서 컨테이너 교체 → 헬스 체크(실패 시 이전 이미지로 롤백) → Mattermost 알림
// Jenkins 작업 설정: Pipeline script from SCM · 브랜치 */dev · Script Path = BE/Jenkinsfile
// 서버 준비물: /home/ubuntu/app/docker-compose.yml, /home/ubuntu/app/.env (infra/server/app 참고)

pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    environment {
        IMAGE    = 'nyam-backend'
        APP_DIR  = '/home/ubuntu/app'
        TEST_NET = "nyam-test-${BUILD_NUMBER}"
        TEST_DB  = "nyam-test-db-${BUILD_NUMBER}"
        TEST_RABBIT = "nyam-test-rabbit-${BUILD_NUMBER}"
    }

    stages {
        stage('Backend') {
            // 프론트엔드만 바뀐 푸시는 건너뜀. Jenkins에서 직접 [지금 빌드]를 누르면 항상 실행
            when {
                anyOf {
                    changeset 'BE/**'
                    triggeredBy 'UserIdCause'
                }
            }
            stages {
                stage('Test') {
                    steps {
                        // 배포 단계에 들어왔다는 표시. 알림은 이 값이 있을 때만 보낸다 (docs만 바뀐 푸시는 조용히 끝남)
                        script { env.BACKEND_DEPLOY = 'true' }
                        // Jenkins는 서버 Docker를 쓰므로 작업 폴더를 마운트하지 않고, Dockerfile의 build 단계 이미지 안에서 테스트한다.
                        // 테스트 전용 PostgreSQL·RabbitMQ를 임시 네트워크에 띄워 마이그레이션·엔티티·메시지 전달까지 확인
                        sh '''
                            docker build --target build -t $IMAGE-test:latest BE
                            docker network create $TEST_NET
                            docker run -d --name $TEST_DB --network $TEST_NET \
                              -e POSTGRES_DB=nyamnyam -e POSTGRES_USER=test -e POSTGRES_PASSWORD=test pgvector/pgvector:pg17
                            docker run -d --name $TEST_RABBIT --network $TEST_NET \
                              -e RABBITMQ_DEFAULT_USER=test -e RABBITMQ_DEFAULT_PASS=test rabbitmq:4-management
                            # 초기화 중 임시 서버는 TCP를 열지 않으므로 127.0.0.1로 확인해야 진짜 준비 완료
                            for i in $(seq 1 30); do
                              if docker exec $TEST_DB pg_isready -h 127.0.0.1 -U test -d nyamnyam > /dev/null 2>&1; then break; fi
                              sleep 2
                            done
                            docker exec $TEST_DB pg_isready -h 127.0.0.1 -U test -d nyamnyam
                            for i in $(seq 1 30); do
                              if docker exec $TEST_RABBIT rabbitmq-diagnostics -q check_running > /dev/null 2>&1 && \
                                 docker exec $TEST_RABBIT rabbitmq-diagnostics -q check_port_connectivity > /dev/null 2>&1; then break; fi
                              sleep 2
                            done
                            docker exec $TEST_RABBIT rabbitmq-diagnostics -q check_running
                            docker exec $TEST_RABBIT rabbitmq-diagnostics -q check_port_connectivity
                            docker run --rm --network $TEST_NET \
                              -e SPRING_DATASOURCE_URL=jdbc:postgresql://$TEST_DB:5432/nyamnyam \
                              -e SPRING_DATASOURCE_USERNAME=test -e SPRING_DATASOURCE_PASSWORD=test \
                              -e SPRING_RABBITMQ_HOST=$TEST_RABBIT -e SPRING_RABBITMQ_PORT=5672 \
                              -e SPRING_RABBITMQ_USERNAME=test -e SPRING_RABBITMQ_PASSWORD=test \
                              -e RECOMMENDATION_REASON_OUTBOX_ENABLED=false \
                              -e SPRING_RABBITMQ_LISTENER_SIMPLE_AUTO_STARTUP=false \
                              -e SPRING_RABBITMQ_LISTENER_DIRECT_AUTO_STARTUP=false \
                              $IMAGE-test:latest ./gradlew test --no-daemon
                        '''
                    }
                    post {
                        always {
                            sh 'docker rm -f $TEST_DB $TEST_RABBIT > /dev/null 2>&1 || true; docker network rm $TEST_NET > /dev/null 2>&1 || true'
                        }
                    }
                }
                stage('Build image') {
                    steps {
                        sh 'docker build -t $IMAGE:$BUILD_NUMBER -t $IMAGE:latest BE'
                    }
                }
                stage('Deploy') {
                    steps {
                        // 롤백용으로 지금 돌고 있는 이미지에 previous 태그를 남김 (첫 배포처럼 컨테이너가 없으면 건너뜀)
                        sh '''
                            if CURRENT=$(docker inspect -f '{{.Image}}' backend 2> /dev/null); then
                              docker image tag "$CURRENT" $IMAGE:previous
                            else
                              echo "no running backend container, rollback image not saved"
                            fi
                        '''
                        script { env.DEPLOY_STARTED = 'true' }
                        sh 'docker compose -f $APP_DIR/docker-compose.yml up -d --force-recreate backend'
                    }
                }
                stage('Health check') {
                    steps {
                        // Jenkins와 백엔드가 같은 backend 네트워크에 있어 컨테이너 이름으로 접근
                        sh '''
                            for i in $(seq 1 60); do
                              if curl -fs http://backend:8080/actuator/health | grep -q '"status":"UP"'; then
                                echo "backend is UP"
                                exit 0
                              fi
                              sleep 3
                            done
                            echo "backend did not become healthy in 3 minutes"
                            docker logs --tail 150 backend
                            exit 1
                        '''
                    }
                }
            }
            post {
                failure {
                    // 컨테이너를 바꾼 뒤 실패했으면 이전 이미지로 되돌림. 테스트·이미지 빌드에서 실패했으면 서버는 그대로
                    script {
                        if (env.DEPLOY_STARTED == 'true') {
                            def rc = sh(returnStatus: true, script: '''
                                docker image inspect $IMAGE:previous > /dev/null 2>&1 || exit 2
                                docker image tag $IMAGE:previous $IMAGE:latest
                                docker compose -f $APP_DIR/docker-compose.yml up -d --force-recreate backend
                            ''')
                            env.ROLLED_BACK = rc == 0 ? 'true' : 'false'
                        }
                    }
                }
            }
        }
    }

    post {
        success {
            script {
                if (env.BACKEND_DEPLOY == 'true') {
                    mattermostSend color: 'good',
                        message: "✅ 백엔드 배포 성공 · ${env.JOB_NAME} #${env.BUILD_NUMBER} · ${env.BUILD_URL}"
                }
            }
        }
        failure {
            script {
                if (env.BACKEND_DEPLOY == 'true') {
                    def serverState = env.DEPLOY_STARTED != 'true' ? '배포 전 단계에서 중단, 서버는 이전 버전 그대로'
                        : env.ROLLED_BACK == 'true' ? '이전 버전으로 롤백함'
                        : '롤백 실패 또는 이전 이미지 없음, 서버 확인 필요'
                    mattermostSend color: 'danger',
                        message: "❌ 백엔드 배포 실패 · ${env.JOB_NAME} #${env.BUILD_NUMBER} · ${serverState} · 로그: ${env.BUILD_URL}console"
                }
            }
        }
        always {
            // 태그가 없어진 옛 이미지 정리 (디스크 관리)
            sh 'docker image prune -f || true'
        }
    }
}
