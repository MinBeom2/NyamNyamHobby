# 이 파일을 복사해 BE/.env 를 만들고 값을 채웁니다. (.env 는 커밋 금지)
# docker compose 와 Spring Boot(application.yml 의 spring.config.import)가 같은 .env 를 읽습니다.

# ── 로컬 인프라 (docker-compose.yml) ──
DB_NAME=nyamnyam
DB_USER=nyamnyam
DB_PASSWORD=
DB_PORT=5432

REDIS_PASSWORD=
REDIS_PORT=6379

RABBITMQ_USER=nyamnyam
RABBITMQ_PASSWORD=
RABBITMQ_PORT=5672

# ── 애플리케이션 비밀값 (기능 개발 시 채움, 비워 둬도 기동은 됨) ──
JWT_SECRET=
FRONTEND_URL=http://localhost:5173

# 이미지 업로드(게시판). 로컬은 기본값(./uploads, http://localhost:8080)이면 충분
# UPLOAD_DIR=./uploads
# UPLOAD_PUBLIC_BASE_URL=http://localhost:8080
# 탐색 세션 최대 노출 수 (기본 12, 허용 범위 1~32767). 변경 후 재시작하면 새 세션부터 적용
EXPLORATION_SESSION_SIZE=12
EXPLORATION_PREFER_RATIO=0.7
# AI 추천 이유 발행 요청 처리(기본 true). false면 요청이 DB에 대기하며 다시 true로 켜면 재개
RECOMMENDATION_REASON_OUTBOX_ENABLED=true

# GMS (GPT-4o)
GMS_BASE_URL=
GMS_API_KEY=

# 메일 (Gmail SMTP 앱 비밀번호)
MAIL_USERNAME=
MAIL_APP_PASSWORD=

# 소셜 로그인 (Google, P1)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 외부 데이터 API
YOUTUBE_API_KEY=
# 숏폼 수집 스케줄러(매시 수집·목요일 반영). 로컬은 false 권장(할당량 사용), 서버만 true
SHORT_COLLECT_ENABLED=false
# 장소 자동 수집 스케줄러(매주 일 03:00 서울 자치구 x 취미별 카카오 로컬 검색). 서버에서만 true
PLACE_COLLECT_ENABLED=false
KAKAO_REST_API_KEY=
# KAKAO_LOCAL_API_KEY 도 같은 값으로 인식
KAKAO_LOCAL_API_KEY=
# 정보 피드 수집 스케줄러(매일 05:00 TourAPI·KOPIS·문화포털, 05:30 서울 공공 강좌). 서버에서만 true
FEED_COLLECT_ENABLED=false
TOUR_API_KEY=
KOPIS_API_KEY=
CULTURE_PORTAL_API_KEY=
PUBLIC_DATA_API_KEY=
SEOUL_OPEN_API_KEY=

# 운영 알림
MATTERMOST_WEBHOOK_URL=
# 신고 알림(매시 정각, 비공개 채널 웹훅). 비우면 알림을 보내지 않음
REPORT_MATTERMOST_WEBHOOK_URL=
# 신고 처리 버튼 서명 키(32자 이상 임의 문자열). 비우면 버튼 없이 알림만 보냄
REPORT_ACTION_SECRET=
# true면 매시 정각을 기다리지 않고 신고 즉시 알림(로컬 확인용, 서버는 false)
REPORT_NOTIFY_IMMEDIATELY=false
