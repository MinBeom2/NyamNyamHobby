# 이 파일을 복사해 BE/.env 를 만들고 값을 채웁니다. (.env 는 커밋 금지)
# docker compose 와 Spring Boot(application.yml 의 spring.config.import)가 같은 .env 를 읽습니다.

# ── 로컬 인프라 (docker-compose.yml) ──
DB_NAME=nyamnyam
DB_USER=nyamnyam
DB_PASSWORD=
DB_PORT=5432

REDIS_PASSWORD=
REDIS_PORT=6379

RABBITMQ_USER=nyamnyam
RABBITMQ_PASSWORD=
RABBITMQ_PORT=5672

# ── 애플리케이션 비밀값 (기능 개발 시 채움, 비워 둬도 기동은 됨) ──
JWT_SECRET=
FRONTEND_URL=http://localhost:5173

# GMS (GPT-4o)
GMS_BASE_URL=
GMS_API_KEY=

# 메일 (Gmail SMTP 앱 비밀번호)
MAIL_USERNAME=
MAIL_APP_PASSWORD=

# 소셜 로그인 (Google, P1)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 외부 데이터 API
YOUTUBE_API_KEY=
KAKAO_REST_API_KEY=
TOUR_API_KEY=
KOPIS_API_KEY=
CULTURE_PORTAL_API_KEY=
PUBLIC_DATA_API_KEY=
SEOUL_OPEN_API_KEY=

# 운영 알림
MATTERMOST_WEBHOOK_URL=
